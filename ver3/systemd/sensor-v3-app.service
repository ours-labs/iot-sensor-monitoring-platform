[Unit]
Description=Sensor Web App Ver.3 Production (Gunicorn, sanitized template)
After=network-online.target sensor-v3-server.service
Wants=network-online.target

[Service]
Type=simple
User=sensorapp
WorkingDirectory=/opt/sensor-monitoring/ver3/web-app
EnvironmentFile=-/etc/sensor-monitoring/web.env
Environment=EXPECTED_SYSTEM_MAJOR=3
Environment=SYSTEM_BUILD_CHANNEL=production
ExecStartPre=/bin/sh -c 'test -x /opt/sensor-monitoring/ver3/.venv/bin/gunicorn || { echo "[CFG-S001] Ver3 INSTALL_ROOT or Gunicorn virtual environment is unavailable" >&2; exit 78; }'
ExecStart=/opt/sensor-monitoring/ver3/.venv/bin/gunicorn \
    --bind 127.0.0.1:5001 \
    --workers 2 \
    --threads 4 \
    --timeout 30 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile - \
    app:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
