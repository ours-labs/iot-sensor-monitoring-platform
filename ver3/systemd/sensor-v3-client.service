[Unit]
Description=Raspberry Pi Sensor Client Ver.3 Production (sanitized template)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sensorapp
WorkingDirectory=/opt/sensor-monitoring/ver3
EnvironmentFile=-/etc/sensor-monitoring/client.env
Environment=EXPECTED_SYSTEM_MAJOR=3
Environment=SYSTEM_BUILD_CHANNEL=production
ExecStartPre=/bin/sh -c 'test -x /opt/sensor-monitoring/ver3/.venv/bin/python || { echo "[CFG-S001] Ver3 INSTALL_ROOT or Python virtual environment is unavailable" >&2; exit 78; }'
ExecStart=/opt/sensor-monitoring/ver3/.venv/bin/python sensor_client_tiered.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
