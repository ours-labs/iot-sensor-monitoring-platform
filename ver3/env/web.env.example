# Ver3 Flask. Keep deployment domains, database credentials, and cookie secrets outside Git.
DATABASE_URL=
TOKEN_HASH_KEY=
SECRET_KEY=
ACCESS_TRUSTED_HOST=
FLASK_HOST=127.0.0.1
FLASK_PORT=
FLASK_DEBUG=0
TABLE_ROW_LIMIT=100

# Set this with tools/set_admin_password.py on the server; never store plaintext passwords.
ADMIN_PASSWORD_HASH=
ADMIN_IDLE_SECONDS=600
ADMIN_ABSOLUTE_SECONDS=1800
ADMIN_REAUTH_SECONDS=300
