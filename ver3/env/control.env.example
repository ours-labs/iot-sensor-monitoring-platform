# Ver3 Raspberry Pi control. Keep deployment values and secrets outside Git.
CONTROL_BASE_URL=https://sensor-v3.example.invalid
DEVICE_ID=
DEVICE_TOKEN=
CONTROL_DB_PATH=/var/lib/sensor-monitoring/control_agent.db
CONTROL_POLL_SECONDS=10
CONTROL_HTTP_TIMEOUT=10
# Keep this true until live control has been explicitly enabled.
CONTROL_DRY_RUN=true
