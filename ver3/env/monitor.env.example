# Per-device Ver3 monitoring.
DATABASE_URL=
MONITOR_POLL_INTERVAL_SEC=5
# Allow six 10-second intervals before reporting loss of communication.
MONITOR_STALE_THRESHOLD_SEC=60
# Repeat journal notices at most every 15 minutes; emit DB and webhook notices only on state changes.
MONITOR_STALE_REPEAT_LOG_SEC=900
# Optional. If empty, record events only in PostgreSQL, the admin interface, and the journal.
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_TIMEOUT_SEC=5
MONITOR_NOTIFICATION_MAX_BACKOFF_SEC=900
