# Shared Ver3 template. Do not add deployment IPs, domains, email addresses, operator IDs, or keys.
# Store deployment values in an EnvironmentFile outside Git.

# [CFG-D001/D002] PostgreSQL connection. SQLite URLs are rejected.
DATABASE_URL=
TOKEN_HASH_KEY=

# [CFG-W002] A sufficiently long random value for Flask cookie signing.
SECRET_KEY=

# [CFG-W003] Hostname protected by the selected access gateway.
ACCESS_TRUSTED_HOST=

# Bind to 127.0.0.1 unless remote access is intentionally configured.
FLASK_HOST=127.0.0.1

# [CFG-W006] Required port in the range 1-65535.
FLASK_PORT=

FLASK_DEBUG=0
TABLE_ROW_LIMIT=100
